# Slamtec RPLIDAR USB adapters (Silicon Labs CP210x) -> /dev/rplidar
# Installed to /etc/udev/rules.d/ by bootstrap_ros2_jazzy.sh
# Note: matches any CP210x. If another CP210x device is added to the rover,
# narrow this with ATTRS{serial}=="..." (see: udevadm info -a -n /dev/ttyUSB0).
KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0666", GROUP:="dialout", SYMLINK+="rplidar"
