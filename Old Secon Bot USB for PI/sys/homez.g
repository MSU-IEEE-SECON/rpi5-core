; homez.g
; called to home the Z axis

M98 P"config_probe.g"									; Load BLTouch probe settings
G29 S2													; cancel mesh bed compensation
;-----------------------Left Level----------------------
G91														; relative positioning
G1 H2 Z10 F6000											; lift Z relative to current position
G90														; absolute positioning

G1 X{move.axes[0].min+60} Y{move.axes[1].min+60} F6000 	; move to front left

G1 F600													; slow speed
G30														; home Z by probing the bed
;-----------------------Right Level---------------------
G91														; relative positioning
G1 H2 Z5 F6000											; lift z relative to current position
G90														; absolute positioning

G1 X{move.axes[0].min+400} Y{move.axes[1].min+60} F6000 ; move to front right

G1 F600													; slow speed
G30														; home Z by probing the bed
;-----------------------End Leveling--------------------
G1 X{move.axes[0].min+60} Y{move.axes[1].min+60} F6000 ; move to front right
G29 S1													; load heightmap


; generated by RepRapFirmware Configuration Tool v3.4.0-LPC-STM32+7 on Wed Nov 08 2023 16:52:16 GMT-0600 (Central Standard Time)
;G91               ; relative positioning
;G1 H2 Z5 F6000    ; lift Z relative to current position
;G1 H1 Z-425 F1800 ; move Z down until the endstop is triggered
;G92 Z0            ; set Z position to axis minimum (you may want to adjust this)

;G91
;G1 H2 Z5 F6000    ; lift Z relative to current position
;G1 H1 Z-425 F1000 ; move Z down until the endstop is triggered

; Uncomment the following lines to lift Z after probing
;G91              ; relative positioning
;G1 Z5 F100       ; lift Z relative to current position
;G90              ; absolute positioning

