; homeall.g
; called to home all axes
M98 P"config_probe.g"												; Load BLTouch probe settings
G29 S2																; cancel mesh bed compensation

G91																	; relative positioning
M913 X50 															; X axis 50% power

G1 H2 Z10 F200														; lift Z relative to current position
G1 H1 X{(move.axes[0].max+5)*-1} Y{(move.axes[1].max+5)*-1} F3000	; move quickly to X and Y axis endstops and stop there (first pass)
G1 H2 X2 Y-2 F600													; go back a few mm
G1 H1 X{(move.axes[0].max+5)*-1} Y{(move.axes[1].max+5)*-1} F600	; move slowly to X and Y axis endstops once more (second pass)

M913 X100 															; X axis 100% power
G90																	; absolute positioning

G1 X{move.axes[0].min+60} Y{move.axes[1].min+60} F6000 				; move to front left
G1 F600																; reduce speed
G30																	; home Z by probing the bed

G1 X{move.axes[0].min+400} Y{move.axes[1].min+60} F6000				; move to front left
G1 F600																; reduce speed
G30																	; home Z by probing the bed

G1 X{move.axes[0].min+60} Y{move.axes[1].min+60} F6000 ; move to front right
G29 S1																; load heightmap


